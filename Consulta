<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Farmacia - Consulta de Stock</title>
</head>
<body>
    <h1>Búsqueda y Consulta de Medicamentos</h1>
    <form>
        <input type="text" placeholder="Buscar por nombre o principio activo..." size="40">
        <button type="button">Buscar</button>
    </form>

    <h2>Resultados de Existencias</h2>
    <table border="1" cellpadding="8">
        <thead>
            <tr>
                <th>Código</th>
                <th>Medicamento</th>
                <th>Laboratorio</th>
                <th>Precio</th>
                <th>Stock Disponible</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>MED-001</td>
                <td>Paracetamol 500mg</td>
                <td>Genfar</td>
                <td>S/. 1.50</td>
                <td>120</td>
            </tr>
            <tr>
                <td>MED-002</td>
                <td>Amoxicilina 500mg</td>
                <td>Bayer</td>
                <td>S/. 12.00</td>
                <td>45</td>
            </tr>
        </tbody>
    </table>
</body>
</html>
